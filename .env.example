# Project URL aus Supabase → Project Settings → API → "Project URL"
# WICHTIG: nur die Basis-URL, OHNE /rest/v1/ und OHNE trailing slash
# Richtig:  https://abcdefgh.supabase.co
# Falsch:   https://abcdefgh.supabase.co/rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# "anon" / "public" key (nicht service_role)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
